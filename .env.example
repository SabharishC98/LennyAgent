# Lenny Growth Assistant — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
#
# Required for cloud LLM features:
#   GROQ_API_KEY — get from https://console.groq.com
#   ANTHROPIC_API_KEY — optional, get from https://console.anthropic.com
#
# Required for all features (including local demo):
#   Ollama must be running locally.
#   Run: ollama pull nomic-embed-text && ollama pull qwen2.5:7b

# LLM Provider: ollama | groq | anthropic
LLM_PROVIDER=groq

# Fallback chain (comma-separated, in priority order)
LLM_FALLBACK=ollama

# Groq (cloud, free tier available)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Ollama (local, MANDATORY for demo)
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5:7b

# Embeddings — always Ollama nomic-embed-text (do not change)
EMBED_MODEL=nomic-embed-text

# Anthropic (optional, paid)
ANTHROPIC_API_KEY=

# PostgreSQL + pgvector (managed by Docker Compose)
DATABASE_URL=postgresql://lenny:lenny@db:5432/lenny

# Agent service internal URL (managed by Docker Compose)
AGENT_URL=http://agent:8001

# Transcript repository — set to your transcript repo URL
# This is required for ingestion. The repository must contain
# transcript files (format documented in architecture.md).
TRANSCRIPT_REPO_URL=
